# Example only. Do not put real production values in Git.

HUB_PUBLIC_BASE_URL=https://links.example.com
HUB_PUBLIC_HOST_ALIASES=link.example.com
# Optional: old public hosts that should redirect the hub page path to the
# canonical links.* site. Do not put full URLs here.
HUB_LEGACY_REDIRECT_HOSTS=sub.example.com
HUB_PAGE_PATH=/links
HUB_BASIC_AUTH_USER=viewer
HUB_BASIC_AUTH_PASSWORD=change-me

HUB_SPARKLE_PATH=/s/<OPAQUE_SPARKLE_PATH>
HUB_SHADOWROCKET_CONFIG_PATH=/s/<OPAQUE_SHADOWROCKET_CONFIG_PATH>
HUB_IOS_ORDINARY_PATH=/s/<OPAQUE_IOS_ORDINARY_PATH>
HUB_IOS_HY2_PATH=/s/<OPAQUE_IOS_HY2_PATH>

SUBSTORE_LOCAL_BASE_URL=http://127.0.0.1:19093
SUBSTORE_BACKEND_PATH=/api/deploy-time-replaced
SUBSTORE_MIHOMO_FILE=frontier-chain-mihomo
SUBSTORE_IOS_ORDINARY_COLLECTION=ios-airports-uri
SUBSTORE_IOS_HY2_COLLECTION=ios-evoxt-hy2-shadowrocket

HUB_REMOTE_ROOT=/opt/frontier/subscription-hub
HUB_LOCAL_SERVICE_URL=http://subscription-hub:19180
HUB_CONTAINER_NAME=subscription-hub
HUB_DOCKER_NETWORK=frontier-sub-store_default
HUB_CADDY_IMAGE=caddy:2.10.0-alpine
# Public rule mirrors are served under this host at /rules/*. Do not use Basic
# Auth for them; Shadowrocket and Mihomo clients fetch them directly.

# Use caddy for the current SJC stack. OpenResty keys are kept for older hosts.
HUB_INGRESS_KIND=caddy
HUB_CADDY_CONTAINER=caddy-edge
HUB_CADDYFILE_PATH=/opt/codex-stacks/caddy/Caddyfile
HUB_SUBSTORE_CONTAINER=frontier-sub-store

HUB_OPENRESTY_CONTAINER=1Panel-openresty
HUB_OPENRESTY_CONF_PATH=/opt/1panel/apps/openresty/openresty/www/sites/substore.example.com/proxy/site.conf
