# Copy to shared-hy2/.secrets.local/shared-hy2.env and replace placeholders.
# Keep this file public-safe. Do not put live values in Git.

# SSH/deploy target. Prefer a local SSH alias with key/port in ~/.ssh/config.
SSH_TARGET=sjc-snap
REMOTE_DIR=/opt/shared-hy2

# Public HY2 endpoint shown in user YAML/links.
SHARED_HY2_PUBLIC_HOST=shared.example.com
SHARED_HY2_CLIENT_SNI=shared.example.com
SHARED_HY2_CLIENT_SKIP_CERT_VERIFY=false

# Certificate paths as seen inside the Hysteria containers.
SHARED_HY2_CERTIFICATE=/certs/fullchain.pem
SHARED_HY2_PRIVATE_KEY=/certs/privkey.pem

# Host certificate files/directories mounted into each container.
# These are remote host paths, not local Windows paths.
SHARED_HY2_HOST_CERTIFICATE=/opt/shared-hy2/secrets/fullchain.pem
SHARED_HY2_HOST_PRIVATE_KEY=/opt/shared-hy2/secrets/privkey.pem

# User credentials. The generator can create these with --init-secrets.
SHARED_HY2_U01_PASSWORD=replace-with-random-password
SHARED_HY2_U02_PASSWORD=replace-with-random-password
SHARED_HY2_U03_PASSWORD=replace-with-random-password

# Stats API secret. The generator can create this with --init-secrets.
SHARED_HY2_STATS_SECRET=replace-with-random-stats-secret

# Limits. Client view: download is server up, upload is server down.
SHARED_HY2_CLIENT_DOWN=100 Mbps
SHARED_HY2_CLIENT_UP=20 Mbps
SHARED_HY2_MONTHLY_QUOTA_GB=200
SHARED_HY2_WARN_GB=160
SHARED_HY2_MAX_ONLINE_DEVICES=2

# Telegram is optional. If empty, monitor prints reports but does not send.
# If present, values stay in this private env only.
TG_TOKEN=
TG_CHATID=
